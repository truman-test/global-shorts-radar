  "_doc": "The white note card: every headline and every key text sits on it, on every stage. Fixed shape: radius, soft shadow, folded top-right corner, faint paper grain."
 },
 "caption": {
  "mode": "outline",
  "fill": "#FFFFFF",
  "highlight": "#FFD23F",
  "outline": "#000000",
